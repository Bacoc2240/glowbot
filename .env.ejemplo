# ── Núcleo ──
SECRET_KEY=genera-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos (desarrollo local) ──
# En Railway NO se usan: la plataforma inyecta DATABASE_URL automáticamente.
DB_NAME=glowbot
DB_USER=postgres
DB_PASSWORD=tu-contraseña-local
DB_HOST=localhost
DB_PORT=5432

# ── Asistente IA ──
ANTHROPIC_API_KEY=sk-ant-...

# ══════════════════════════════════════════════════════════════
# PRODUCCIÓN (Railway) — variables a definir en el panel del servicio
# ══════════════════════════════════════════════════════════════
# SECRET_KEY=<clave nueva, distinta a la de desarrollo>
# DEBUG=False
# ALLOWED_HOSTS=glowbot.com.co,www.glowbot.com.co
# DATABASE_URL=<lo inyecta Railway al vincular PostgreSQL>
#
# Correo (RF-22 recuperación de contraseña)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=tu-correo@gmail.com
# EMAIL_HOST_PASSWORD=<contraseña de aplicación de 16 dígitos>
# DEFAULT_FROM_EMAIL=GlowBot <no-responder@glowbot.com.co>
#
# Cloudinary (comprobantes de pago — Railway tiene disco efímero)
# USAR_CLOUDINARY=True
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
#
# Opcionales de seguridad
# SECURE_SSL_REDIRECT=True     (por defecto True cuando DEBUG=False)
# SECURE_HSTS_SECONDS=3600     (subir a 31536000 cuando el dominio esté estable)
